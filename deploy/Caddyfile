# Caddy configuration for manourying.manouri.ovh
#
# Phase 1 serves the static site and nothing else. The api and admin blocks are
# written out but commented, so that bringing them up later is uncommenting
# rather than remembering.

manourying.manouri.ovh {
	root * /srv/manourying/web

	encode zstd gzip

	# The site is built with `format: 'file'`, so /faq is /faq.html on disk.
	# try_files gives clean URLs without a redirect round trip.
	try_files {path} {path}.html {path}/index.html

	file_server

	handle_errors {
		@404 expression {err.status_code} == 404
		rewrite @404 /404.html
		file_server
	}

	header {
		# The explainer page is linked from App Store review notes and from
		# inside the app; it must not be framed or sniffed into something else.
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin

		# Google Fonts is the only third-party origin the site touches.
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; script-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"

		# Long cache for fingerprinted assets, none for HTML, so a redeploy is
		# visible immediately.
		?Cache-Control "public, max-age=300"
	}

	@immutable path /_astro/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# App-links files must be served as JSON. Only matters once they exist —
	# see deploy/README.md for why they are not deployed yet.
	@wellknown path /.well-known/assetlinks.json /.well-known/apple-app-site-association
	header @wellknown Content-Type application/json

	log {
		output file /var/log/caddy/manourying.log
		# No IPs in the log. There is no analytics on this site and no reason
		# to accumulate a record of who read the privacy page.
		format filter {
			request>remote_ip delete
			request>client_ip delete
		}
	}
}

