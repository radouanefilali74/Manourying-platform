{
  "name": "manourying-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Public website, API, and admin panel for Manourying.",
  "scripts": {
    "setup": "npm --prefix web ci && npm --prefix server ci && npm --prefix admin ci",
    "dev": "npm --prefix web run dev",
    "dev:api": "npm --prefix server run dev",
    "dev:admin": "npm --prefix admin run dev",
    "build": "npm --prefix web run build",
    "build:admin": "npm --prefix admin run build",
    "preview": "npm --prefix web run preview",
    "check": "npm --prefix web run astro -- check",
    "check:server": "npm --prefix server run typecheck",
    "check:admin": "npm --prefix admin run typecheck",
    "check:parity": "node scripts/check-parity.mjs ../Manourying",
    "directive:hash": "node scripts/directive-hash.mjs ../Manourying",
    "db:migrate": "npm --prefix server run db:migrate",
    "test:server": "npm --prefix server test",
    "verify": "npm run check && npm run check:server && npm run check:admin && npm run check:parity && npm run build && npm run build:admin",
    "deploy": "./deploy/publish.sh",
    "deploy:api": "./deploy/publish-api.sh",
    "deploy:admin": "./deploy/publish-admin.sh",
    "push": "./deploy/push.sh"
  },
  "devDependencies": {
    "playwright": "^1.57.0"
  }
}
