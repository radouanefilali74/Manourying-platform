{
  "name": "manourying-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Public website, API, and admin panel for Manourying.",
  "scripts": {
    "dev": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "preview": "npm --prefix web run preview",
    "check": "npm --prefix web exec astro check",
    "check:parity": "node scripts/check-parity.mjs ../manourying",
    "directive:hash": "node scripts/directive-hash.mjs ../manourying",
    "verify": "npm run check && npm run check:parity && npm run build"
  },
  "devDependencies": {
    "playwright": "^1.57.0"
  }
}
