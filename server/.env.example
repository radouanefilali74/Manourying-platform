# Copy to server/.env and fill in. `chmod 600` it — it holds the database
# password, and systemd reads it via `node --env-file` rather than an
# `EnvironmentFile=` directive precisely so `systemctl show` cannot print it.
#
# This file (the .example) is committed; .env is not. See the root .gitignore.

NODE_ENV=development
HOST=127.0.0.1
PORT=8080

# The API's role. Cannot alter the schema, and has INSERT/SELECT but no
# UPDATE/DELETE on audit_log — which is what makes the audit log append-only.
DATABASE_URL=postgres://manourying_app:CHANGEME@127.0.0.1:5432/manourying

# The owning role. Used ONLY by `npm run db:migrate`, never at runtime.
MIGRATE_DATABASE_URL=postgres://manourying_owner:CHANGEME@127.0.0.1:5432/manourying

# Database index 3 and the `mnr:` key prefix keep this clear of the other
# tenant on this box, which shares the Redis instance.
REDIS_URL=redis://127.0.0.1:6379/3

# The exact origin the panel is served from. Never a wildcard: credentialed
# requests carry the session cookie, and `*` is not permitted with credentials.
#   dev:  http://127.0.0.1:5173
#   prod: https://admin.manourying.manouri.ovh
ADMIN_ORIGIN=http://127.0.0.1:5173

# Off in dev only, where the panel is served over http through the Vite proxy
# and a Secure cookie would never be stored at all.
COOKIE_SECURE=false

SESSION_HOURS=12
SESSION_IDLE_HOURS=2

# The app-facing routes (/seats, /cells, /counts, …) are implemented and tested
# but must not be reachable until the app is actually wired to this API. Two
# independent switches have to flip: this one, and nginx proxying those paths at
# all. An unauthenticated POST /cells that nothing uses is pure abuse surface.
#
# Turn it on locally to run the claim-race test.
PUBLIC_API=false

# Where the two directive sources live, so the publish endpoint can refuse to
# publish a hash the shipped artefacts do not actually produce.
APP_REPO_PATH=../Manourying
