{
  "name": "server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Manourying API — Fastify + Postgres. Serves the admin panel; the app-facing routes are built but not exposed.",
  "engines": {
    "node": ">=22.12.0"
  },
  "comment": "Node 24 strips TypeScript types natively, so there is no tsx and no ts-node here. tsc is kept only to typecheck and to emit dist/ for systemd.",
  "scripts": {
    "dev": "node --env-file=.env --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "node --env-file=.env src/db/migrate.ts",
    "db:seed": "node --env-file=.env src/bin/seed-dev.ts",
    "admin": "node --env-file=.env src/bin/admin.ts",
    "test": "node --env-file-if-exists=.env --env-file-if-exists=.env.test --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/rate-limit": "^10.2.2",
    "@node-rs/argon2": "^2.0.2",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.3"
  }
}
