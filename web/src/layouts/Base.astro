---
import '../styles/tokens.css';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { SITE_ORIGIN } from '../config';
import {
  getDictionary,
  LOCALE_FONT_QUERY,
  LOCALE_NAME,
  LOCALE_SANS_STACK,
  PAGE_LOCALES,
  PAGE_PATH,
  RTL_LOCALES,
  type Locale,
  type NavKey,
  type PageKey,
} from '../i18n';

interface Props {
  title: string;
  description: string;
  /** Set on the landing page, which carries its own full-bleed hero. */
  bare?: boolean;
  /**
   * Which page this is, in the locale/page registry (`src/i18n/pages.ts`).
   * Drives the nav's hrefs, the hreflang tags, and the language switcher —
   * all three read `PAGE_LOCALES[page]` so none of them can point at a
   * locale that has not actually been translated yet.
   */
  page: PageKey;
  /** Defaults to English — every page not yet migrated to the dictionary omits this and is unaffected. */
  locale?: Locale;
}

const { title, description, bare = false, page, locale = 'en' } = Astro.props;

const dict = getDictionary(locale);
const isRtl = RTL_LOCALES.has(locale);
const availableLocales = PAGE_LOCALES[page];

const canonical = new URL(Astro.url.pathname, SITE_ORIGIN).href;
const here = Astro.url.pathname.replace(/\/$/, '') || '/';

const NAV_ITEMS: { key: NavKey; page: PageKey }[] = [
  { key: 'whatThisIs', page: 'whatThisIs' },
  { key: 'faq', page: 'faq' },
  { key: 'directive', page: 'directive' },
  { key: 'privacy', page: 'privacy' },
  { key: 'press', page: 'press' },
];

/**
 * A nav destination links to the current locale's version of that page ONLY
 * if that page/locale pair actually exists (`PAGE_LOCALES`); otherwise it
 * falls back to the canonical English page rather than a 404. This is what
 * lets the site ship locale by locale, page by page, without ever showing a
 * broken link mid-rollout.
 */
function navHref(target: PageKey): string {
  return PAGE_LOCALES[target].includes(locale)
    ? getRelativeLocaleUrl(locale, PAGE_PATH[target])
    : PAGE_PATH[target];
}

const localeFontQuery = LOCALE_FONT_QUERY[locale];
const localeSansStack = LOCALE_SANS_STACK[locale];
---

<!doctype html>
<html lang={locale} dir={isRtl ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {
      // hreflang, one per locale this page actually has, plus x-default
      // pointing at the English version — which every page has, since English
      // is the baseline every entry in PAGE_LOCALES includes.
      availableLocales.map((l) => (
        <link
          rel="alternate"
          hreflang={l}
          href={new URL(getRelativeLocaleUrl(l, PAGE_PATH[page]), SITE_ORIGIN).href}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(PAGE_PATH[page], SITE_ORIGIN).href}
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0A0D18" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@300;400;500&family=IBM+Plex+Sans:wght@300;400;500&family=Instrument+Serif&display=swap"
    />
    {
      // Extra script coverage IBM Plex / Instrument Serif do not have — only
      // requested on the locales that need it. See src/i18n/fonts.ts.
      localeFontQuery && (
        <link rel="stylesheet" href={`https://fonts.googleapis.com/css2?${localeFontQuery}&display=swap`} />
      )
    }
    {
      localeSansStack && (
        <style set:html={`:root { --sans: ${localeSansStack}, var(--sans); }`} />
      )
    }
  </head>

  <body>
    <a class="skip" href="#main">{dict.common.skipToContent}</a>

    <header class="site-head">
      <div class="wrap head-inner">
        <a class="mark" href={navHref('index')}>MANOURYING</a>
        <nav aria-label="Primary">
          {
            NAV_ITEMS.map((item) => {
              const href = navHref(item.page);
              return (
                <a href={href} aria-current={here === href ? 'page' : undefined}>
                  {dict.common.nav[item.key]}
                </a>
              );
            })
          }
        </nav>
        {
          // A native <details>/<summary> disclosure, not a <select>: a <select>
          // needs JavaScript to navigate on change, and this site has to work
          // with JS disabled (CLAUDE.md). <details> opens and closes, and every
          // entry is a plain link, with zero script required for the dropdown
          // itself to function — the closing script below is polish, not a
          // dependency.
          availableLocales.length > 1 && (
            <details class="lang-switch">
              <summary aria-label="Language">
                <span class="mono">{locale.toUpperCase()}</span>
              </summary>
              <ul>
                {
                  availableLocales.map((l) => (
                    <li>
                      <a
                        href={getRelativeLocaleUrl(l, PAGE_PATH[page])}
                        aria-current={l === locale ? 'page' : undefined}
                        lang={l}
                      >
                        <span class="code mono">{l.toUpperCase()}</span>
                        <span class="name">{LOCALE_NAME[l]}</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </details>
          )
        }
      </div>
    </header>

    <main id="main" class={bare ? '' : 'wrap page'}>
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap">
        <hr class="rule" />
        {
          dict.common.translationNotice && (
            <p class="fine translation-notice">{dict.common.translationNotice}</p>
          )
        }
        <div class="foot-inner">
          <p class="fine">{dict.common.footerTagline}</p>
          <nav aria-label="Footer">
            {
              NAV_ITEMS.map((item) => {
                const href = navHref(item.page);
                return <a href={href}>{dict.common.nav[item.key]}</a>;
              })
            }
          </nav>
        </div>
      </div>
    </footer>

    <style>
      .skip {
        position: absolute;
        inset-inline-start: -9999px;
      }
      .skip:focus {
        inset-inline-start: var(--gutter);
        top: 10px;
        z-index: 10;
        background: var(--panel);
        padding: 10px 14px;
        border-radius: 2px;
      }

      .site-head {
        border-bottom: 1px solid var(--edge);
        position: sticky;
        top: 0;
        background: color-mix(in srgb, var(--ink) 92%, transparent);
        backdrop-filter: blur(8px);
        z-index: 5;
      }
      .head-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding-block: 14px;
        flex-wrap: wrap;
      }
      .mark {
        font-family: var(--mono);
        font-weight: 500;
        font-size: 0.75rem;
        letter-spacing: 0.3em;
        color: var(--bone);
        text-decoration: none;
      }
      .site-head nav {
        display: flex;
        gap: clamp(12px, 2.5vw, 26px);
        flex-wrap: wrap;
      }
      .site-head nav a {
        font-family: var(--mono);
        font-size: 0.66rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--slate);
        text-decoration: none;
        /* Padding, not just line-height, is what gives a touch target real
           height — text alone here is under 25px tall, well short of the
           ~44px guideline. The gap between links is untouched by this. */
        padding-block: 9px;
      }
      .site-head nav a:hover,
      .site-head nav a[aria-current='page'] {
        color: var(--bone);
      }
      .lang-switch {
        position: relative;
        margin-inline-start: clamp(12px, 2.5vw, 26px);
        padding-inline-start: clamp(12px, 2.5vw, 26px);
        border-inline-start: 1px solid var(--edge);
      }
      .lang-switch summary {
        display: flex;
        align-items: center;
        gap: 6px;
        list-style: none;
        cursor: pointer;
        color: var(--dim);
        font-size: 0.66rem;
        letter-spacing: 0.1em;
        padding: 9px 12px;
        border: 1px solid transparent;
        border-radius: 2px;
      }
      /* Chrome/Safari draw their own disclosure triangle; replaced with the chevron below. */
      .lang-switch summary::-webkit-details-marker {
        display: none;
      }
      .lang-switch summary::after {
        content: '';
        width: 5px;
        height: 5px;
        border-inline-end: 1px solid currentColor;
        border-block-end: 1px solid currentColor;
        transform: rotate(45deg);
        margin-block-start: -3px;
        transition: transform 0.15s ease;
      }
      .lang-switch summary:hover {
        color: var(--bone);
      }
      .lang-switch[open] summary {
        color: var(--bone);
        border-color: var(--edge);
      }
      .lang-switch[open] summary::after {
        transform: rotate(225deg);
        margin-block-start: 3px;
      }
      .lang-switch ul {
        position: absolute;
        top: calc(100% + 6px);
        inset-inline-end: 0;
        z-index: 20;
        margin: 0;
        padding: 4px;
        list-style: none;
        min-width: 11rem;
        max-height: 60vh;
        overflow-y: auto;
        background: var(--panel);
        border: 1px solid var(--edge);
        border-radius: 3px;
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.4);
      }
      .lang-switch ul a {
        display: flex;
        align-items: baseline;
        gap: 9px;
        padding: 10px 12px;
        border-radius: 2px;
        text-decoration: none;
        color: var(--mist);
        font-size: 0.82rem;
      }
      .lang-switch ul a:hover {
        background: var(--dusk);
        color: var(--bone);
      }
      .lang-switch ul a[aria-current='page'] {
        color: var(--brass);
      }
      .lang-switch .code {
        min-width: 1.8em;
        font-size: 0.62rem;
        letter-spacing: 0.06em;
        color: var(--dim);
      }
      .lang-switch ul a:hover .code,
      .lang-switch ul a[aria-current='page'] .code {
        color: inherit;
      }

      /*
       * Below this width, `.head-inner`'s own flex-wrap can push the switcher
       * onto its own row, and that row is not guaranteed to sit at the header's
       * trailing edge — space-between puts a lone wrapped item at the LEADING
       * edge instead. The desktop panel is positioned via `inset-inline-end: 0`
       * relative to the trigger, so in that situation it would try to open
       * further off the leading edge — off-screen, with no way back on via
       * CSS alone. Rather than chase exact wrap breakpoints, the panel drops
       * out of absolute positioning entirely here and becomes a normal
       * full-width block in the document flow, directly under its trigger.
       * That makes off-screen impossible by construction, not by coincidence,
       * and larger tap targets are a welcome side effect on a touch device.
       */
      @media (max-width: 40rem) {
        .lang-switch {
          width: 100%;
          margin-inline-start: 0;
          padding-inline-start: 0;
          border-inline-start: none;
          border-top: 1px solid var(--edge);
          margin-top: 6px;
          padding-top: 6px;
        }
        .lang-switch summary {
          justify-content: space-between;
        }
        .lang-switch ul {
          position: static;
          width: 100%;
          min-width: 0;
          margin-top: 6px;
          max-height: none;
          box-shadow: none;
        }
      }

      .page {
        padding-block: clamp(40px, 8vw, 76px) 80px;
      }

      .site-foot {
        margin-top: auto;
        padding-bottom: 40px;
      }
      .translation-notice {
        margin-top: 14px;
        color: var(--dim);
      }
      .foot-inner {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
        padding-top: 22px;
      }
      .site-foot nav {
        display: flex;
        gap: 18px;
        flex-wrap: wrap;
      }
      .site-foot nav a {
        font-family: var(--mono);
        font-size: 0.66rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--dim);
        text-decoration: none;
        padding-block: 6px;
      }
      .site-foot nav a:hover {
        color: var(--slate);
      }

      body {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
    </style>

    <script>
      // Pure polish: the dropdown fully works without this — every entry is a
      // real link, and <details> opens/closes natively via click or keyboard.
      // This just closes it on an outside click or Escape, which native
      // <details> does not do on its own.
      const switcher = document.querySelector<HTMLDetailsElement>('.lang-switch');
      if (switcher) {
        document.addEventListener('click', (event) => {
          if (switcher.open && !switcher.contains(event.target as Node)) {
            switcher.removeAttribute('open');
          }
        });
        switcher.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && switcher.open) {
            switcher.removeAttribute('open');
            switcher.querySelector('summary')?.focus();
          }
        });
      }
    </script>
  </body>
</html>
