---
import Base from '../layouts/Base.astro';
---

<Base title="Manourying — Not found" description="That page does not exist.">
  <p class="eyebrow">404</p>
  <h1 class="serif">Nothing here.</h1>
  <p class="lede">
    The page you asked for does not exist. The things that definitely do:
  </p>
  <ul>
    <li><a href="/what-this-is">What this actually is</a></li>
    <li><a href="/faq">Questions people ask</a></li>
    <li><a href="/install">Getting the app</a></li>
  </ul>
</Base>

<style>
  h1 {
    font-size: clamp(2rem, 6vw, 3rem);
    line-height: 1.05;
    margin-block: 14px 20px;
  }
  ul {
    padding-left: 1.1rem;
    margin-top: 1em;
    color: var(--mist);
    line-height: 2;
  }
</style>
