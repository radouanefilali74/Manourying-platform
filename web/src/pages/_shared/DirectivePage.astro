---
import Base from '../../layouts/Base.astro';
import { canonicalDirective, groupHash, sealHash } from '../../lib/directive';
import { UNSEAL_UTC } from '../../config';
import { getDictionary, type Locale } from '../../i18n';

/**
 * The published seal.
 *
 * ONLY the prose around the seal is translated here. `canonicalDirective()`,
 * `sealHash()`, `groupHash()` and `DIRECTIVE_STEPS` itself are untouched and
 * imported exactly as in the original page — the published hash is computed
 * from one English source shared with the app, and translating it would need
 * a per-locale hash plus a matching app-repo change, which is out of scope.
 * See the i18n plan for the full reasoning.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale).directive;

const hash = sealHash();
const canonical = canonicalDirective();
const unseal = new Date(UNSEAL_UTC).toISOString().replace('T', ' ').replace('.000Z', ' UTC');

/** The score is not secret — only its exact final wording is. */
const revealed = false;
---

<Base title={t.title} description={t.description} page="directive" locale={locale}>
  <p class="eyebrow">{revealed ? t.eyebrowOpen : t.eyebrowSealed}</p>
  <h1 class="serif">{t.h1}</h1>

  <p class="lede">{t.lede}</p>

  <div class="seal">
    <p class="eyebrow">{t.sealEyebrow}</p>
    <p class="hash mono" id="hash">{groupHash(hash)}</p>
    <button class="copy" data-copy={hash} data-copied-label={t.copiedLabel} type="button">
      {t.copyButton}
    </button>
  </div>

  <section>
    <h2>{t.checkHeading}</h2>
    <p>
      {t.checkP1Before} <span class="mono">{unseal}</span> {t.checkP1After}
    </p>
    <pre><code>printf '%s' "$DIRECTIVE" | sha256sum</code></pre>
    <p>{t.checkP2}</p>
  </section>

  <section>
    <h2>{t.knownHeading}</h2>
    <p>{t.knownBody}</p>
    {
      revealed && (
        <pre class="canonical"><code>{canonical}</code></pre>
      )
    }
  </section>

  <hr class="rule" />
  <p class="fine">{t.footerFine}</p>
</Base>

<script>
  const button = document.querySelector<HTMLButtonElement>('.copy');
  button?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(button.dataset.copy ?? '');
      const original = button.textContent;
      button.textContent = button.dataset.copiedLabel ?? original;
      setTimeout(() => (button.textContent = original), 1600);
    } catch {
      // Clipboard blocked — the hash is selectable on the page anyway.
    }
  });
</script>

<style>
  h1 {
    font-size: clamp(2rem, 6vw, 3rem);
    line-height: 1.05;
    margin-block: 14px 20px;
  }
  .seal {
    border: 1px solid var(--edge);
    background: var(--dusk);
    border-radius: 3px;
    padding: clamp(18px, 3vw, 26px);
    margin-block: clamp(26px, 4vw, 38px);
  }
  .hash {
    font-size: clamp(0.8rem, 2.6vw, 1.05rem);
    line-height: 1.9;
    color: var(--brass);
    word-break: break-all;
    margin-top: 10px;
    user-select: all;
  }
  .copy {
    margin-top: 14px;
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--slate);
    background: none;
    border: 1px solid var(--edge);
    border-radius: 2px;
    padding: 9px 14px;
    cursor: pointer;
  }
  .copy:hover {
    color: var(--bone);
    border-color: var(--slate);
  }
  section {
    margin-top: clamp(24px, 4vw, 34px);
  }
  h2 {
    font-family: var(--sans);
    font-weight: 500;
    font-size: 1.05rem;
    color: var(--bone);
    margin-bottom: 9px;
  }
  p {
    color: var(--mist);
    max-width: var(--measure);
    line-height: 1.72;
  }
  p + p {
    margin-top: 0.9em;
  }
  pre {
    background: var(--void);
    border: 1px solid var(--edge);
    border-radius: 3px;
    padding: 14px 16px;
    overflow-x: auto;
    margin-top: 12px;
    max-width: var(--measure);
    /* The shell command / canonical text stay left-to-right and left-aligned
       even on an RTL page — this is literal code and a verification payload,
       not prose, and mirroring it would make it harder to read, not easier. */
    direction: ltr;
    text-align: left;
  }
  code {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--live);
  }
  .canonical code {
    color: var(--bone);
    white-space: pre-wrap;
  }
  .fine {
    margin-top: 20px;
    max-width: var(--measure);
  }
</style>
