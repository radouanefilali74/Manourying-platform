---
import Base from '../../layouts/Base.astro';
import Countdown from '../../components/Countdown.astro';
import { INSTALL_PATH, RITUAL_SECONDS, TONE_HZ } from '../../config';
import { getDictionary, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale).index;
---

<Base title={t.title} description={t.description} bare page="index" locale={locale}>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">{t.eyebrow}</p>
      <h1 class="serif">{t.h1}</h1>
      <p class="lede">
        {t.ledePrefix}{RITUAL_SECONDS}{t.ledeSuffix}
      </p>

      <Countdown locale={locale} t={t.countdown} />

      <div class="actions">
        <a class="btn" href={INSTALL_PATH}>{t.ctaGetApp}</a>
        <a class="btn ghost" href="/what-this-is">{t.ctaWhatThisIs}</a>
      </div>
    </div>
  </section>

  <div class="wrap">
    <hr class="rule" />

    <section class="score">
      <p class="eyebrow">{t.scoreEyebrow}</p>
      <ol>
        {
          t.score.map((step) => (
            <li>
              <span class="mono at">{step.at}</span>
              <div>
                <h2 class="serif">{step.heading}</h2>
                <p>{step.detail}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="fine">
        {t.scoreFineBefore} <a href="/directive">{t.scoreFineLink}</a>.
      </p>
    </section>

    <hr class="rule" />

    <section class="facts">
      <div>
        <p class="eyebrow">{t.factsPitchEyebrow}</p>
        <p class="fact mono">{TONE_HZ} Hz</p>
        <p class="note">{t.factsPitchNote}</p>
      </div>
      <div>
        <p class="eyebrow">{t.factsInstantEyebrow}</p>
        <p class="fact mono">14:05 UTC</p>
        <p class="note">{t.factsInstantNote}</p>
      </div>
      <div>
        <p class="eyebrow">{t.factsNotifEyebrow}</p>
        <p class="fact mono">{t.factsNotifValue}</p>
        <p class="note">{t.factsNotifNote}</p>
      </div>
    </section>

    <hr class="rule" />

    <section class="closing">
      <h2 class="serif">{t.closingHeading}</h2>
      <p class="prose">{t.closingBody}</p>
      <p class="more">
        <a href="/faq">{t.moreLink}</a>
      </p>
    </section>
  </div>
</Base>

<style>
  .hero {
    padding-block: clamp(48px, 11vw, 110px) clamp(30px, 6vw, 56px);
    /*
     * A dawn limb — the lit edge of a planet seen from outside it — drawn
     * entirely from the design tokens rather than shipped as an image.
     *
     * This replaced a photographic background. An image was the wrong tool
     * here twice over: sizing it correctly needs the hero's rendered aspect
     * ratio, which isn't knowable across 11 locales and every viewport, and
     * whatever fade ends it has to meet the flat page ground somewhere,
     * which is a seam waiting to happen. Gradients have neither problem —
     * they're defined in percentages of the box, so the composition scales
     * with it, and there is no edge to meet anything at. It also costs zero
     * requests and cannot drift out of the palette, since it literally
     * reads --brass/--mist/--slate/--ink.
     *
     * Geometry: both glows ride ONE ellipse centred well below and right of
     * the box, so the slice of it crossing the hero reads as a gentle curve
     * rather than a flat band. Stops past 100% are the region outside the
     * ellipse — that's the sky above the limb. Warm rim hugging the arc,
     * cool halo spread wider around it, one accent, no third colour.
     *
     * The opacities are not eyeballed. Every stop below was checked by
     * rendering this exact gradient stack per-pixel and measuring the
     * brightest point under each block of copy against the colour that
     * actually renders there and the threshold that actually applies —
     * 3:1 for the large serif h1, 4.5:1 for the small --slate eyebrow and
     * the --mist lede. The eyebrow is the binding constraint by some
     * distance: --slate on bare --ink is only 4.70:1 to begin with, so the
     * scrim has to hold the top-left at essentially pure ink. Measured at
     * 1600x760 / 1280x700: eyebrow 4.68:1, h1 10.38:1, lede 7.12:1.
     */
    background-color: var(--ink);
    background-image:
      /* scrim: holds the text column at ink, and biases the glow right */
      linear-gradient(
        100deg,
        color-mix(in srgb, var(--ink) 94%, transparent) 0%,
        color-mix(in srgb, var(--ink) 88%, transparent) 40%,
        color-mix(in srgb, var(--ink) 55%, transparent) 60%,
        color-mix(in srgb, var(--ink) 5%, transparent) 80%,
        color-mix(in srgb, var(--ink) 18%, transparent) 100%
      ),
      /* the warm rim, riding the arc itself */
      radial-gradient(
        ellipse 75% 110% at 80% 155%,
        transparent 93%,
        color-mix(in srgb, var(--brass) 32%, transparent) 99%,
        color-mix(in srgb, var(--brass) 15%, transparent) 101.5%,
        transparent 109%
      ),
      /* the cool halo, spread around it */
      radial-gradient(
        ellipse 75% 110% at 80% 155%,
        transparent 78%,
        color-mix(in srgb, var(--slate) 26%, transparent) 94%,
        color-mix(in srgb, var(--mist) 46%, transparent) 100%,
        color-mix(in srgb, var(--slate) 24%, transparent) 105%,
        transparent 123%
      );
  }

  /*
   * Arabic puts the copy on the right, which is exactly where the glow
   * lives — so the whole composition mirrors, or the contrast measured
   * above stops meaning anything. A horizontal mirror of both the gradient
   * and the text it protects yields identical luminance by construction,
   * so the numbers above carry over unchanged: angle 100deg becomes 260deg
   * (360 - 100) and the ellipse's 80% becomes 20%.
   *
   * :global() is required because <html dir> is set by Base.astro, outside
   * this component, so Astro's scoping would otherwise never match it.
   */
  :global(html[dir='rtl']) .hero {
    background-image:
      linear-gradient(
        260deg,
        color-mix(in srgb, var(--ink) 94%, transparent) 0%,
        color-mix(in srgb, var(--ink) 88%, transparent) 40%,
        color-mix(in srgb, var(--ink) 55%, transparent) 60%,
        color-mix(in srgb, var(--ink) 5%, transparent) 80%,
        color-mix(in srgb, var(--ink) 18%, transparent) 100%
      ),
      radial-gradient(
        ellipse 75% 110% at 20% 155%,
        transparent 93%,
        color-mix(in srgb, var(--brass) 32%, transparent) 99%,
        color-mix(in srgb, var(--brass) 15%, transparent) 101.5%,
        transparent 109%
      ),
      radial-gradient(
        ellipse 75% 110% at 20% 155%,
        transparent 78%,
        color-mix(in srgb, var(--slate) 26%, transparent) 94%,
        color-mix(in srgb, var(--mist) 46%, transparent) 100%,
        color-mix(in srgb, var(--slate) 24%, transparent) 105%,
        transparent 123%
      );
  }

  /*
   * On a narrow hero the copy spans the full width, so there is no clear
   * side to give the arc — and the same percentages produce a completely
   * different shape, because rx resolves against a small width while ry
   * resolves against a tall height, turning the flat limb into a steep
   * rainbow arch straight through the heading. Widening the ellipse far
   * past the viewport restores the flat sweep and dropping it below the
   * copy makes it a horizon under the text. Symmetric, so it needs no RTL
   * variant. Measured at 420x800, 360x720 and 768x900: eyebrow 4.71:1,
   * h1 15.54:1, lede 6.39:1.
   */
  @media (max-width: 48rem) {
    .hero,
    :global(html[dir='rtl']) .hero {
      background-image:
        linear-gradient(
          100deg,
          color-mix(in srgb, var(--ink) 80%, transparent) 0%,
          color-mix(in srgb, var(--ink) 60%, transparent) 45%,
          color-mix(in srgb, var(--ink) 22%, transparent) 75%,
          color-mix(in srgb, var(--ink) 30%, transparent) 100%
        ),
        radial-gradient(
          ellipse 260% 60% at 50% 148%,
          transparent 93%,
          color-mix(in srgb, var(--brass) 30%, transparent) 99%,
          color-mix(in srgb, var(--brass) 14%, transparent) 101.5%,
          transparent 109%
        ),
        radial-gradient(
          ellipse 260% 60% at 50% 148%,
          transparent 78%,
          color-mix(in srgb, var(--slate) 24%, transparent) 94%,
          color-mix(in srgb, var(--mist) 42%, transparent) 100%,
          color-mix(in srgb, var(--slate) 22%, transparent) 105%,
          transparent 123%
        );
    }
  }
  h1 {
    font-size: clamp(2.3rem, 7.5vw, 4.2rem);
    line-height: 1.02;
    margin-block: 18px 22px;
    max-width: 18ch;
  }

  .actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 30px;
  }
  .btn {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    background: var(--brass);
    padding: 14px 22px;
    border: 1px solid var(--brass);
    border-radius: 2px;
  }
  .btn.ghost {
    background: none;
    color: var(--slate);
    border-color: var(--edge);
  }
  .btn.ghost:hover {
    color: var(--bone);
    border-color: var(--slate);
  }

  section {
    padding-block: clamp(34px, 6vw, 58px);
  }

  .score ol {
    list-style: none;
    padding: 0;
    margin-top: 22px;
  }
  .score li {
    display: flex;
    gap: clamp(14px, 3vw, 26px);
    padding-bottom: 26px;
  }
  .score .at {
    color: var(--brass);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    padding-top: 8px;
    min-width: 4.2em;
  }
  .score h2 {
    font-size: clamp(1.25rem, 3.4vw, 1.6rem);
    line-height: 1.25;
  }
  .score p {
    color: var(--mist);
    font-size: 0.93rem;
    margin-top: 7px;
    max-width: var(--measure);
  }
  .score .fine {
    margin-top: 4px;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
    gap: clamp(22px, 4vw, 40px);
  }
  .fact {
    font-size: 1.8rem;
    font-weight: 300;
    margin-top: 8px;
  }
  .note {
    color: var(--slate);
    font-size: 0.85rem;
    margin-top: 8px;
    line-height: 1.6;
  }

  .closing h2 {
    font-size: clamp(1.5rem, 4vw, 2rem);
    margin-bottom: 14px;
  }
  .more {
    margin-top: 20px;
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .more a {
    text-decoration: none;
  }
</style>
