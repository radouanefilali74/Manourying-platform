---
import Base from '../../layouts/Base.astro';
import { CONTACT_EMAIL, MOMENT_UTC, SITE_ORIGIN, TONE_HZ } from '../../config';
import { getDictionary, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale).press;

const instant = new Date(MOMENT_UTC).toISOString().replace('T', ' ').replace('.000Z', ' UTC');
---

<Base title={t.title} description={t.description} page="press" locale={locale}>
  <p class="eyebrow">{t.eyebrow}</p>
  <h1 class="serif">{t.h1}</h1>

  <p class="lede">{t.lede}</p>

  <section>
    <h2>{t.oneParagraphHeading}</h2>
    <blockquote>
      {t.quoteBefore} {TONE_HZ} {t.quoteAfter}
    </blockquote>
  </section>

  <section>
    <h2>{t.factsHeading}</h2>
    <dl class="facts">
      <div><dt>{t.factInstant}</dt><dd class="mono">{instant}</dd></div>
      <div><dt>{t.factDuration}</dt><dd class="mono">{t.factDurationValue}</dd></div>
      <div><dt>{t.factPitch}</dt><dd class="mono">{TONE_HZ} Hz</dd></div>
      <div><dt>{t.factCadence}</dt><dd class="mono">{t.factCadenceValue}</dd></div>
      <div><dt>{t.factEntry}</dt><dd class="mono">{t.factEntryValue}</dd></div>
      <div><dt>{t.factPlatforms}</dt><dd class="mono">{t.factPlatformsValue}</dd></div>
      <div><dt>{t.factCost}</dt><dd class="mono">{t.factCostValue}</dd></div>
    </dl>
  </section>

  <section>
    <h2>{t.threeThingsHeading}</h2>
    <p>{t.threeThingsIntro}</p>
    <ul>
      <li>
        <strong>{t.thingSeismic.strong}</strong> {t.thingSeismic.rest}
      </li>
      <li>
        <strong>{t.thingSimultaneous.strong}</strong> {t.thingSimultaneous.rest}
      </li>
      <li>
        <strong>{t.thingCampaign.strong}</strong> {t.thingCampaign.rest}
      </li>
    </ul>
  </section>

  <section>
    <h2>{t.contactHeading}</h2>
    <p>
      <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> {t.contactAfter}
    </p>
    <p class="fine">
      {t.canonicalLabel} <a href={`${SITE_ORIGIN}/what-this-is`}>{SITE_ORIGIN}/what-this-is</a>
    </p>
  </section>
</Base>

<style>
  h1 {
    font-size: clamp(2rem, 6vw, 3rem);
    line-height: 1.05;
    margin-block: 14px 20px;
  }
  section {
    margin-top: clamp(26px, 4vw, 38px);
  }
  h2 {
    font-family: var(--sans);
    font-weight: 500;
    font-size: 1.05rem;
    color: var(--bone);
    margin-bottom: 9px;
  }
  p,
  li {
    color: var(--mist);
    max-width: var(--measure);
    line-height: 1.72;
  }
  p + p {
    margin-top: 0.9em;
  }
  blockquote {
    margin: 0;
    padding-inline-start: 18px;
    border-inline-start: 1px solid var(--brass);
    color: var(--bone);
    max-width: var(--measure);
    line-height: 1.75;
  }
  ul {
    padding-inline-start: 1.1rem;
    margin-top: 0.6em;
  }
  li + li {
    margin-top: 0.7em;
  }
  strong {
    color: var(--bone);
    font-weight: 500;
  }
  .facts {
    margin: 12px 0 0;
  }
  .facts > div {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    border-top: 1px solid var(--edge);
    padding-block: 10px;
  }
  .facts dt {
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--slate);
    min-width: 11rem;
  }
  .facts dd {
    margin: 0;
    color: var(--bone);
    font-size: 0.88rem;
  }
  .fine {
    margin-top: 14px;
  }
</style>
