---
import Base from '../layouts/Base.astro';
import { canonicalDirective, groupHash, sealHash } from '../lib/directive';
import { UNSEAL_UTC } from '../config';

/**
 * The published seal.
 *
 * This page is the difference between a mystery and a con, and it costs one
 * page of copy. Anyone can compute the hash themselves from the canonical text
 * once it is revealed and check it against what was published months earlier.
 */

const hash = sealHash();
const canonical = canonicalDirective();
const unseal = new Date(UNSEAL_UTC).toISOString().replace('T', ' ').replace('.000Z', ' UTC');

/** The score is not secret — only its exact final wording is. */
const revealed = false;
---

<Base
  title="Manourying — The sealed directive"
  description="The SHA-256 hash of the sealed directive, published in advance so it can be verified afterwards."
>
  <p class="eyebrow">Directive 02 · {revealed ? 'open' : 'sealed'}</p>
  <h1 class="serif">The seal</h1>

  <p class="lede">
    The exact wording of the directive is published seven days before the equinox. Its hash is
    published <em>now</em>, so that afterwards anybody can check that the text they were given is
    the text that was sealed — including if they do not trust us.
  </p>

  <div class="seal">
    <p class="eyebrow">SHA-256 of the sealed directive</p>
    <p class="hash mono" id="hash">{groupHash(hash)}</p>
    <button class="copy" data-copy={hash} type="button">Copy hash</button>
  </div>

  <section>
    <h2>How to check it yourself</h2>
    <p>
      When the directive opens on <span class="mono">{unseal}</span>, take its canonical form —
      each step as <span class="mono">time⇥heading⇥detail</span>, one per line, joined by newlines,
      encoded UTF-8 — and hash it:
    </p>
    <pre><code>printf '%s' "$DIRECTIVE" | sha256sum</code></pre>
    <p>
      If that does not produce the string above, something changed between the seal and the
      reveal, and you should say so loudly.
    </p>
  </section>

  <section>
    <h2>What is already known</h2>
    <p>
      The structure was never secret and is written on the front page: four seconds of an open
      vowel, one spoken name, ten seconds of silence. What is sealed is the precise wording —
      which words, in which order, translated into every language at once.
    </p>
    {
      revealed && (
        <pre class="canonical"><code>{canonical}</code></pre>
      )
    }
  </section>

  <hr class="rule" />
  <p class="fine">
    The same hash is displayed inside the app, computed independently on your own device from the
    copy shipped in the binary. Two computations, one number — if they ever disagree, trust neither.
  </p>
</Base>

<script>
  const button = document.querySelector<HTMLButtonElement>('.copy');
  button?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(button.dataset.copy ?? '');
      const original = button.textContent;
      button.textContent = 'Copied';
      setTimeout(() => (button.textContent = original), 1600);
    } catch {
      // Clipboard blocked — the hash is selectable on the page anyway.
    }
  });
</script>

<style>
  h1 {
    font-size: clamp(2rem, 6vw, 3rem);
    line-height: 1.05;
    margin-block: 14px 20px;
  }
  .seal {
    border: 1px solid var(--edge);
    background: var(--dusk);
    border-radius: 3px;
    padding: clamp(18px, 3vw, 26px);
    margin-block: clamp(26px, 4vw, 38px);
  }
  .hash {
    font-size: clamp(0.8rem, 2.6vw, 1.05rem);
    line-height: 1.9;
    color: var(--brass);
    word-break: break-all;
    margin-top: 10px;
    user-select: all;
  }
  .copy {
    margin-top: 14px;
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--slate);
    background: none;
    border: 1px solid var(--edge);
    border-radius: 2px;
    padding: 9px 14px;
    cursor: pointer;
  }
  .copy:hover {
    color: var(--bone);
    border-color: var(--slate);
  }
  section {
    margin-top: clamp(24px, 4vw, 34px);
  }
  h2 {
    font-family: var(--sans);
    font-weight: 500;
    font-size: 1.05rem;
    color: var(--bone);
    margin-bottom: 9px;
  }
  p {
    color: var(--mist);
    max-width: var(--measure);
    line-height: 1.72;
  }
  p + p {
    margin-top: 0.9em;
  }
  pre {
    background: var(--void);
    border: 1px solid var(--edge);
    border-radius: 3px;
    padding: 14px 16px;
    overflow-x: auto;
    margin-top: 12px;
    max-width: var(--measure);
  }
  code {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--live);
  }
  .canonical code {
    color: var(--bone);
    white-space: pre-wrap;
  }
  .fine {
    margin-top: 20px;
    max-width: var(--measure);
  }
</style>
