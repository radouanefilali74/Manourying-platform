---
import Base from '../layouts/Base.astro';
import { INSTALL_PATH } from '../config';

/**
 * Where an invite link lands when the app is not installed.
 *
 * Once App Links / Universal Links are verified (Phase 5), a tap on
 * `https://manourying.manouri.ovh/gate?code=XXXXXX` opens the app directly for
 * anyone who has it. Everyone else — the majority of people receiving a first
 * invite — arrives *here*, and this page has one job: show them their code so
 * it is not lost, explain what they have been given, and get them to the app.
 *
 * The code is read from the query string in the browser rather than at build
 * time, because this is a static page serving every possible code.
 */
---

<Base
  title="Manourying — Your invite"
  description="Somebody spent an invite on you. Here is what that means and what to do with it."
>
  <p class="eyebrow">Somebody spent an invite on you</p>
  <h1 class="serif">A seat at Manourying</h1>

  <div class="code-card" data-code-card hidden>
    <p class="eyebrow">Your code</p>
    <p class="code mono" data-code>——————</p>
    <button class="copy" type="button" data-copy>Copy code</button>
    <p class="fine">Write it down. This link is the only place it exists.</p>
  </div>

  <p class="lede" data-no-code>
    Every seat carries three invites, and they do not replenish — so if somebody sent you one,
    they gave up a third of what they had.
  </p>

  <section>
    <h2>What you have been invited to</h2>
    <p>
      At one fixed instant — the September equinox — everybody holding the app makes the same
      sound at the same time. Four seconds of an open vowel, then your own name, then ten seconds
      of silence. Sixteen seconds, and then it is over.
    </p>
    <p>
      <a href="/what-this-is">The full, plain-language explanation</a> is worth two minutes before
      you install anything.
    </p>
  </section>

  <section>
    <h2>What to do now</h2>
    <ol>
      <li>Install the app.</li>
      <li>Open it and enter your code at the gate.</li>
      <li>Pick where you will actually be standing, and arm the moment.</li>
    </ol>
    <a class="btn" href={INSTALL_PATH}>Get the app</a>
  </section>

  <hr class="rule" />
  <p class="fine">
    If you already have the app installed, this link should have opened it directly. That it did
    not is a known limitation while app-link verification is being set up — enter the code by hand
    and it will work exactly the same.
  </p>
</Base>

<script>
  const params = new URLSearchParams(location.search);
  const raw = (params.get('code') ?? '').trim().toUpperCase();

  // Codes are six characters over an unambiguous alphabet (no 0/O, no 1/I/L).
  // Validating the shape here stops the page rendering whatever somebody put in
  // the query string as though it were a real invite.
  const valid = /^[23456789ABCDEFGHJKMNPQRSTUVWXYZ]{6,12}$/.test(raw);

  if (valid) {
    const card = document.querySelector<HTMLElement>('[data-code-card]');
    const slot = document.querySelector<HTMLElement>('[data-code]');
    const intro = document.querySelector<HTMLElement>('[data-no-code]');
    if (card && slot) {
      slot.textContent = raw;
      card.hidden = false;
      intro?.remove();
    }

    const button = document.querySelector<HTMLButtonElement>('[data-copy]');
    button?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(raw);
        const original = button.textContent;
        button.textContent = 'Copied';
        setTimeout(() => (button.textContent = original), 1600);
      } catch {
        // Clipboard blocked; the code is selectable on the page.
      }
    });
  }
</script>

<style>
  h1 {
    font-size: clamp(2rem, 6vw, 3rem);
    line-height: 1.05;
    margin-block: 14px 22px;
  }
  .code-card {
    border: 1px solid var(--brass);
    background: var(--dusk);
    border-radius: 3px;
    padding: clamp(18px, 3vw, 26px);
    margin-bottom: 26px;
  }
  .code {
    font-size: clamp(1.8rem, 7vw, 2.6rem);
    letter-spacing: 0.3em;
    color: var(--brass);
    margin-top: 10px;
    user-select: all;
  }
  .copy {
    margin-top: 14px;
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--slate);
    background: none;
    border: 1px solid var(--edge);
    border-radius: 2px;
    padding: 9px 14px;
    cursor: pointer;
  }
  .copy:hover {
    color: var(--bone);
    border-color: var(--slate);
  }
  .code-card .fine {
    margin-top: 12px;
  }
  section {
    margin-top: clamp(24px, 4vw, 34px);
  }
  h2 {
    font-family: var(--sans);
    font-weight: 500;
    font-size: 1.05rem;
    color: var(--bone);
    margin-bottom: 9px;
  }
  p,
  li {
    color: var(--mist);
    max-width: var(--measure);
    line-height: 1.72;
  }
  p + p {
    margin-top: 0.9em;
  }
  ol {
    padding-left: 1.2rem;
    margin-top: 0.4em;
  }
  li + li {
    margin-top: 0.4em;
  }
  .btn {
    display: inline-block;
    margin-top: 18px;
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    background: var(--brass);
    padding: 12px 20px;
    border-radius: 2px;
  }
  .fine {
    max-width: var(--measure);
  }
</style>
