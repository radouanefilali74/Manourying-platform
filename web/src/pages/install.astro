---
import Base from '../layouts/Base.astro';
import { BUILDS } from '../content/builds';
import { CONTACT_EMAIL } from '../config';

/**
 * The install page — a permanent URL the app and every invite message can point
 * at, so that an expiring build link never breaks an invite sent months earlier.
 */

const label = { android: 'Android', ios: 'iOS' } as const;
---

<Base
  title="Manourying — Install"
  description="Where to get the app, on Android and iOS."
  page="install"
>
  <p class="eyebrow">Install</p>
  <h1 class="serif">Getting the app</h1>

  <p class="lede">
    Manourying is not on the App Store or Google Play yet. Builds are distributed directly, which
    means a couple of extra taps and one alarming-looking warning from your phone.
  </p>

  <div class="builds">
    {
      BUILDS.map((build) => (
        <div class={`build ${build.available ? '' : 'unavailable'}`}>
          <div class="row">
            <h2>{label[build.platform]}</h2>
            {build.available ? (
              <span class="mono meta">
                v{build.version} · {build.built}
              </span>
            ) : (
              <span class="mono meta">Not yet</span>
            )}
          </div>
          {build.note && <p class="note">{build.note}</p>}
          {build.available && (
            <a class="btn" href={build.url} rel="noopener">
              Install for {label[build.platform]}
            </a>
          )}
        </div>
      ))
    }
  </div>

  <section>
    <h2 class="sub">Already have a code?</h2>
    <p>
      Install the app first, then open it and type your six-character code into the gate. Tapping
      an invite link before the app is installed does nothing — that is a limitation of the link,
      not a problem with your code.
    </p>
  </section>

  <section>
    <h2 class="sub">No code?</h2>
    <p>
      Install anyway and hold a place in the queue. Every seat carries three invites that do not
      replenish, and seats are released into the queue as they free up.
    </p>
  </section>

  <hr class="rule" />
  <p class="fine">
    Something broken? <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
  </p>
</Base>

<style>
  h1 {
    font-size: clamp(2rem, 6vw, 3rem);
    line-height: 1.05;
    margin-block: 14px 20px;
  }
  .builds {
    display: grid;
    gap: 14px;
    margin-block: clamp(26px, 4vw, 36px);
  }
  .build {
    border: 1px solid var(--edge);
    background: var(--dusk);
    border-radius: 3px;
    padding: clamp(16px, 3vw, 22px);
  }
  .build.unavailable {
    opacity: 0.62;
  }
  .row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
  }
  .build h2 {
    font-family: var(--sans);
    font-weight: 500;
    font-size: 1.15rem;
    color: var(--bone);
  }
  .meta {
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--slate);
  }
  .note {
    color: var(--slate);
    font-size: 0.86rem;
    line-height: 1.65;
    margin-top: 10px;
    max-width: var(--measure);
  }
  .btn {
    display: inline-block;
    margin-top: 16px;
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    background: var(--brass);
    padding: 12px 20px;
    border-radius: 2px;
  }
  section {
    margin-top: clamp(24px, 4vw, 32px);
  }
  .sub {
    font-family: var(--sans);
    font-weight: 500;
    font-size: 1.02rem;
    color: var(--bone);
    margin-bottom: 8px;
  }
  section p {
    color: var(--mist);
    max-width: var(--measure);
    line-height: 1.72;
  }
  .fine {
    margin-top: 18px;
  }
</style>
